{
  "name": "proxyip-explorer",
  "version": "0.1.2",
  "private": true,
  "description": "Local Windows ProxyIP catalog, TLS probe and latency monitor",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "net.proxyip.explorer",
    "productName": "ProxyIP Explorer",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "ProxyIP-Explorer-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "ProxyIP-Explorer-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
